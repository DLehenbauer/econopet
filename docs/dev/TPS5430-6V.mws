{PARA 0 "> " 0 "" {MPLTEXT 1 0 587 "# Commodore PET power supply is 9V
 unregulated. \nV[IN(MIN)] := 7.5;     # At maximum load, it's still a
bove 9V.  We use 7.5V to be safe.\nV[IN(MAX)] := 16;      # At minimal
 load, it's ~11.5V.  We use 16V to be safe.\n\nVOUT[TARGET] := 6.1;  #
 Voltage isn't critical for cassette.  ~6.1V is typical.\n\n# Predicte
d 6V load is ~1.2A:\n#   400ma - Datasette A (black C2N stalled at end
-of-tape rewind)\n#   400ma - Datasette B (\")\n#   400ma - Buffer\n# \+
But we use the maximum value of 3 to be safe.\nI_O := 3;\n\n# Inductor
 is +/-20%\nK[IND] := 0.2;\n\nF[SW] := 500 * k;   # Fixed 500kHz switc
hing speed" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#>&%\"VG6#-%#ING6#%$MING
