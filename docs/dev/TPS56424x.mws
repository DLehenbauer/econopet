0 1159 "################################\n# Common\n##################
##############\n\n# Resistor tolerance\nR[TOL] := 0.01;\nR1[MIN] := R1
[TYP] * (1 - R[TOL]);\nR1[MAX] := R1[TYP] * (1 + R[TOL]);\nR2[MIN] := \+
R2[TYP] * (1 - R[TOL]);\nR2[MAX] := R2[TYP] * (1 + R[TOL]);\n\n# Capac
itor tolerance\nC[TOL] := 0.20;\nC[OUT(MIN)] := C[OUT(TYP)] * (1 - C[T
OL]);\nC[OUT(MAX)] := C[OUT(TYP)] * (1 + C[TOL]);\n\nevalf(C[OUT(MIN)]
/u);\nevalf(C[OUT(TYP)]/u);\nevalf(C[OUT(MAX)]/u);\n\n# Inductor toler
ance\nL[TOL] := 0.20;\nL[OUT(TYP)] := 1.8*u;\nL[OUT(MIN)] := L[OUT(TYP
)] * (1 - L[TOL]);\nL[OUT(MAX)] := L[OUT(TYP)] * (1 + L[TOL]);\n\neval
f(L[OUT(MIN)]/u);\nevalf(L[OUT(TYP)]/u);\nevalf(L[OUT(MAX)]/u);\n\n# U
nregulated supply is about 12V unloaded.  We'll use the TPS54624x max \+
of 16V to be safe.\nV[IN(MAX)] := 16;\n\n# Nominal switching frequency
.\n# Datasheet specifies 1200 kHz, but does not provide guaranteed\n# \+
minimum/maximum switching-frequency limits.\nf[SW(TYP)] := 1200*k;\n\n
# Use nominal frequency for the datasheet design calculations.\nf[SW] \+
:= f[SW(TYP)];\n\n# Nominal VREF\nVREF[TYP] := 600*10^(-3);\n\n# Over \+
TJ = -40 C to +125 C\nVREF[MIN] := 591*10^(-3);\nVREF[TYP] := 0.6;\nVR
EF[MAX] := 609*10^(-3);\n" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#>&%\"RG6#
