(TARGET)] := 6.1;\n\n# Maximum output current for 6.1V is ~1.2A:\n#   \+
400ma - Datasette A (black C2N stalled at end-of-tape rewind)\n#   400
ma - Datasette B (\")\n#   400ma - Buffer\n# But we set the TPS54624x \+
max of 4A to be safe.\nI_OUT := 4;\n\n# For 6V the voltage is less cri
tical, so we just use available 0402 1% resistors.\n\nR1[TYP] := 120*k
;\nR2[TYP] := 13*k;\n\n# Derate capacitors for 6.1V\nC_4u7 := 4.7 * (1
