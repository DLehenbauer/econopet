9);\nu := 10^(-6);\nM := 10^6;\nk := 10^3;\n\n# Compute effective resi
stance of parallel resistors\nR_Parallel := proc()\n    local i, R, re
sult;\n\n    R := [args];\n    result := 0;\n\n    for i from 1 to nop
s(R) do\n        result := result + 1/R[i];\n    od;\n\n    1/result;
