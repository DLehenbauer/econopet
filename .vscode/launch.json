{
    // From "Section 7.3: Debugging a Project":
    // https://datasheets.raspberrypi.com/pico/getting-started-with-pico.pdf
    //
    // (Also see "Appendix A: Using Picoprobe")
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Firmware",
            "cwd": "${workspaceRoot}",
            //"executable": "${command:cmake.launchTargetPath}",
            "executable": "${workspaceRoot}/build/fw/src/firmware.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            // Change 'gpbPath' to "arm-none-eabi-gdb" if not using "gdb-multiarch".
            "gdbPath" : "gdb-multiarch",
            "device": "RP2040",
            "configFiles": [
                // Change interface to "interface/picoprobe.cfg" if using older Picoprobe firmware.
                "interface/cmsis-dap.cfg",
                "target/rp2040.cfg"
            ],
            // Reduce the adapter speed if 'openocd' reports the following error:
            // 
            //    Error: Failed to connect multidrop rp2040.dap0
            //
            // Documentation uses 5000 kHz:
            // https://datasheets.raspberrypi.com/pico/getting-started-with-pico.pdf
            //
            // Latest Debugprobe firmware available here:
            // https://github.com/raspberrypi/debugprobe
            //
            // Notes:
            //  - 31250 kHz fails immediately with Debugprobe v2.3.1.
            //  - `cmsis-dap quirk enable` serializes CMSIS-DAP transfers to
            //    work around intermittent probe communication failures that can
            //    report "Could not allocate bounce buffer for flash programming".
            "serverArgs": ["-c", "adapter speed 31249", "-c", "init", "-c", "cmsis-dap quirk enable"],
            "svdFile": "${env:PICO_SDK_PATH}/src/rp2040/hardware_regs/rp2040.svd",
            "runToEntryPoint": "main",
            // Work around for stopping at main on restart
            "postRestartCommands": [
                "break main",
                "continue"
            ],
            "preLaunchTask": "CMake: Build Firmware"
        },
        {
            "name": "Firmware Test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/test/fw/test/firmware-test",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}/build/test/fw/test",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: Build Firmware Test"
        }
    ]
}