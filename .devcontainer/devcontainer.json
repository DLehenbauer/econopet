// For format details, see https://aka.ms/devcontainer.json. For config options,
// see: https://hub.docker.com/r/microsoft/devcontainers-base#about-ubuntu
{
    "name": "EconoPET",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        // Install Node.js (via nvm), plus npm/yarn/pnpm.
        // (See: https://github.com/devcontainers/features/tree/main/src/node)
        "ghcr.io/devcontainers/features/node:2": {},
        // Install Git Large File Support (LFS).
        // (See: https://github.com/devcontainers/features/tree/main/src/git-lfs)
        "ghcr.io/devcontainers/features/git-lfs:1": {},
        // Install the GitHub CLI ('gh').
        // (See: https://github.com/devcontainers/features/tree/main/src/github-cli)
        "ghcr.io/devcontainers/features/github-cli:1": {},
        // Install the GitHub Copilot CLI ('copilot').
        // (See: https://github.com/devcontainers/features/tree/main/src/copilot-cli)
        "ghcr.io/devcontainers/features/copilot-cli:1": {}
    },
    "customizations": {
        "vscode": {
            // Add the IDs of extensions you want installed when the container is created.
            "extensions": [
                "bierner.github-markdown-preview",
                "chris-hock.pioasm",
                "DavidAnson.vscode-markdownlint",
                "GitHub.copilot-chat",
                "marus25.cortex-debug",
                "mcu-debug.peripheral-viewer",
                "ms-vscode.cpptools-extension-pack",
                "mshr-h.veriloghdl",
                "mutantdino.resourcemonitor",
                "streetsidesoftware.code-spell-checker",
                "xaver.clang-format"
            ]
        }
    },
    // You may need to run `sudo modprobe cdc_acm` on Ubuntu to have access to the ttyACM0 device.
    "runArgs": [
        "--privileged", // Required to access Debugprobe from dev container
        "--device=/dev/ttyACM0" // Expose Debugprobe URT to dev container
    ],
    // TODO: Investigate if it is reasonable to run the dev container as a non-root user.
    // (See: https://www.robmiles.com/journal/2024/1/18/effortless-debugging-with-your-pico-probe-no-more-sudo)
    "remoteUser": "root",
    "postCreateCommand": "git config --global --add safe.directory \"$PWD\" && git submodule update --init --recursive --depth 1 --single-branch"
}
