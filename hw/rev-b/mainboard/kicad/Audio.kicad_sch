	(text "Audio"
		(exclude_from_sim no)
		(at 45.72 41.91 0)
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "2cfc100e-f715-4201-a43b-792c94e445a3")
	)
	(text "Twin-T notch filter compensates\nfor 2 KHz resonant frequency of\nour chosen speaker."
		(exclude_from_sim no)
		(at 128.524 86.106 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "307b2906-6c82-46c7-983f-f59e82bd523b")
	)
	(text "PET CB2 and DIAG are connected to FPGA inputs elsewhere\nin the schematic and are therefore not shown on this page.\nWithin the FPGA, DIAG gates the CB2 sound signal, replacing\nthe external AND gate used in the original PET circuitry.\n\nThe FPGA then mixes the gated PET CB2 audio with the\nFPGA-implemented SID audio and outputs separate AUDIO_L\nand AUDIO_R streams. This also allows additional FPGA-based\naudio processing and enhancements.\n\nAUDIO_L/R are 1-bit ΔΣ-encoded (delta-sigma) signals\n(3V3, 64 MHz). A 1 µF capacitor and 12 kΩ resistor filter\nand scale each output to line-level audio (~±0.5 V AC).\n\nAmplifiers and powered speakers typically provide an ~10 kΩ\ninput resistance to ground, forming a voltage divider with\nthe 12 kΩ series resistor.\n\nWhen the audio jack is empty, the 12 kΩ resistors isolate\nand passively combine AUDIO_L/R into a mono signal for the\nbuilt-in speaker on the PCB."
		(exclude_from_sim no)
		(at 45.72 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "945fc921-e219-4353-be22-9bdeb081537b")
	)
	(hierarchical_label "AUDIO_L"
		(shape input)
		(at 43.18 99.06 180)
		(fields_autoplaced yes)
		(effects
