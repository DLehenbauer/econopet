{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Configuration",
            "description": "Configure the EconoPET super-project",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ECONOPET_MEDIA_DIR": {
                    "type": "PATH",
                    "value": "$env{ECONOPET_MEDIA_DIR}"
                }
            }
        }
    ],
    "buildPresets": [
        {
            "name": "all",
            "displayName": "Build All",
            "description": "Build all subprojects (bootloader, ROM, firmware, gateware and simulator models, firmware/system tests, SD card)",
            "configurePreset": "default",
            "targets": ["all_projects"]
        },
        {
            "name": "boot",
            "displayName": "Bootloader",
            "description": "Build the EconoPET SD-card bootloader",
            "configurePreset": "default",
            "targets": ["bootloader_project"]
        },
        {
            "name": "fw",
            "displayName": "Firmware",
            "description": "Build only the RP2040 firmware",
            "configurePreset": "default",
            "targets": ["firmware_project"]
        },
        {
            "name": "fw-test",
            "displayName": "Firmware Tests",
            "description": "Build only the firmware unit tests",
            "configurePreset": "default",
            "targets": ["test_project"]
        },
        {
            "name": "sys-test",
            "displayName": "System Tests",
            "description": "Build host fixtures, hardware contract, board and firmware integration tests",
            "configurePreset": "default",
            "targets": ["system_test_project"]
        },
        {
            "name": "gw-test",
            "displayName": "Gateware Test Models",
            "description": "Build all native Verilator model targets before running gateware tests",
            "configurePreset": "default",
            "targets": ["gateware_models"]
        },
        {
            "name": "gw",
            "displayName": "Gateware",
            "description": "Build only the FPGA gateware",
            "configurePreset": "default",
            "targets": ["fpga_project"]
        },
        {
            "name": "reset",
            "displayName": "Reset MCU",
            "description": "Reset the MCU without reprogramming (over SWD)",
            "configurePreset": "default",
            "targets": ["reset"]
        },
        {
            "name": "prog-boot",
            "displayName": "Program Bootloader",
            "description": "Build and program the bootloader (over SWD)",
            "configurePreset": "default",
            "targets": ["prog-boot"]
        },
        {
            "name": "prog-fw",
            "displayName": "Program Firmware",
            "description": "Build and program firmware (over SWD)",
            "configurePreset": "default",
            "targets": ["prog-fw"]
        },
        {
            "name": "prog-gw",
            "displayName": "Program Gateware",
            "description": "Build and program gateware (over SWD)",
            "configurePreset": "default",
            "targets": ["prog-gw"]
        },
        {
            "name": "prog",
            "displayName": "Program Bootloader, Gateware, and Firmware",
            "description": "Build and program bootloader, gateware, and firmware (over SWD)",
            "configurePreset": "default",
            "targets": ["prog"]
        },
        {
            "name": "sdcard",
            "displayName": "SD Card Package",
            "description": "Build SD card package with all dependencies (firmware, gateware)",
            "configurePreset": "default",
            "targets": ["sdcard_project"]
        },
        {
            "name": "rom",
            "displayName": "ROMs",
            "description": "Build only the ROM subproject (menu and edit ROM)",
            "configurePreset": "default",
            "targets": ["rom_project"]
        },
        {
            "name": "prgs",
            "displayName": "Test Programs",
            "description": "Build all test programs (prgs/)",
            "configurePreset": "default",
            "targets": ["prgs_project"]
        },
        {
            "name": "site",
            "displayName": "Site",
            "description": "Build the static site including manual documentation",
            "configurePreset": "default",
            "targets": ["site"]
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "all",
            "displayName": "All Tests",
            "description": "Run all available tests",
            "inherits": "test-base"
        },
        {
            "name": "fw",
            "displayName": "Firmware Tests",
            "description": "Run only firmware tests",
            "inherits": "test-base",
            "filter": {
                "include": {
                    "label": "fw"
                }
            }
        },
        {
            "name": "sys",
            "displayName": "System Tests",
            "description": "Run host fixtures, hardware contract, board and firmware integration tests",
            "inherits": "test-base",
            "filter": {
                "include": {
                    "label": "sys"
                }
            }
        },
        {
            "name": "gw",
            "displayName": "Gateware Tests",
            "description": "Run the quick gateware benches under Icarus and Verilator",
            "inherits": "test-base",
            "filter": {
                "include": {
                    "label": "iv|vl"
                },
                "exclude": {
                    "label": "boot"
                }
            }
        },
        {
            "name": "gw-iv",
            "displayName": "Gateware Tests (Icarus only)",
            "description": "Run the quick gateware benches under Icarus only",
            "inherits": "test-base",
            "filter": {
                "include": {
                    "label": "iv"
                }
            }
        },
        {
            "name": "gw-vl",
            "displayName": "Gateware Tests (Verilator only)",
            "description": "Run the quick gateware benches under Verilator only",
            "inherits": "test-base",
            "filter": {
                "include": {
                    "label": "vl"
                },
                "exclude": {
                    "label": "boot"
                }
            }
        },
        {
            "name": "gw-boot",
            "displayName": "Gateware Boot Tests",
            "description": "Run the full-boot gateware benches under Verilator (slow)",
            "inherits": "test-base",
            "filter": {
                "include": {
                    "label": "boot"
                }
            }
        }
    ]
}
